{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://ca-finagent.yellowstone-f22fd56b.centralindia.azurecontainerapps.io/api/:path*" },
    { "source": "/outputs/:path*", "destination": "https://ca-finagent.yellowstone-f22fd56b.centralindia.azurecontainerapps.io/outputs/:path*" },
    { "source": "/((?!api/|outputs/|assets/).*)", "destination": "/index.html" }
  ]
}
