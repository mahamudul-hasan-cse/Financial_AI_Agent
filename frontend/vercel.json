{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://BACKEND_URL_PLACEHOLDER/api/:path*" },
    { "source": "/outputs/:path*", "destination": "https://BACKEND_URL_PLACEHOLDER/outputs/:path*" },
    { "source": "/((?!api/|outputs/|assets/).*)", "destination": "/index.html" }
  ]
}
