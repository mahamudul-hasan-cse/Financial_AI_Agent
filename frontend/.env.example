# API base URL (default: /api — works with the Vite dev proxy and when FastAPI
# serves the built frontend). Set to e.g. https://my-api.example.com/api when
# the frontend is hosted separately (add that origin to the backend CORS_ORIGINS).
VITE_API_URL=/api
# Base URL for generated charts (default: /outputs; use https://my-api.example.com/outputs
# when the API is on another origin).
# VITE_OUTPUTS_URL=/outputs
