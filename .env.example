# ── LLM provider ──────────────────────────────────────────────────────────────
# Primary LLM: "openrouter", "groq" or "ollama" (local).
# Unset = "openrouter" when OPENROUTER_API_KEY is set, otherwise "groq".
# With "ollama", the agent uses Ollama and falls back to Groq only if Ollama is
# unreachable AND GROQ_API_KEY is set.
# LLM_PROVIDER=openrouter

# OpenRouter (primary when its key is set). Paid models, tested tool calling.
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# Primary model when LLM_PROVIDER=openrouter (first backup when it is groq)
# OPENROUTER_MODEL=openai/gpt-oss-120b

# Groq (primary without an OpenRouter key; last backup with one). Without any
# key the API still starts, but /api/health reports "degraded" and chat returns 503.
GROQ_API_KEY=your_groq_api_key_here
# Groq model (default openai/gpt-oss-120b). Fastest: openai/gpt-oss-20b;
# also tuned for qwen/qwen3.8-27b. Any Groq model id works.
# GROQ_MODEL=openai/gpt-oss-120b

# ── LLM latency & resilience ──────────────────────────────────────────────────
# Retries after the first attempt when the LLM call fails before any text is
# streamed (429s wait for the provider's Retry-After). The UI shows "Retrying in Ns…".
# LLM_MAX_RETRIES=2
# Longest single wait between retries, in seconds
# LLM_RETRY_MAX_DELAY=20

# ── Backup models ─────────────────────────────────────────────────────────────
# When the primary returns 429/5xx, times out or can't be reached, the same
# request goes straight to the next model (no waiting on Retry-After):
#   openrouter primary: OPENROUTER_FALLBACK_MODELS, then Groq (GROQ_MODEL) if
#                       GROQ_API_KEY is set
#   groq primary:       OPENROUTER_MODEL, then OPENROUTER_FALLBACK_MODELS
# The UI shows "Primary model busy — switched to backup model". If every backup
# fails, the retries above apply to the primary. Setting OPENROUTER_API_KEY
# turns backups on (FALLBACK_PROVIDER defaults to openrouter);
# FALLBACK_PROVIDER=none turns them off.
# FALLBACK_PROVIDER=openrouter
# Comma-separated OpenRouter models tried in order if the previous one fails
# OPENROUTER_FALLBACK_MODELS=google/gemini-2.5-flash
# Paid models (fast, reliable tool calling; ~$0.001-0.003 per backup answer).
# Avoid :free models: capped per day and often rate-limited upstream.
# Max tool calls per answer (each tool round is another full model call)
# AGENT_TOOL_CALL_LIMIT=3
# Tool results longer than this many characters are truncated before the model sees them
# TOOL_OUTPUT_MAX_CHARS=2000
# TTL cache for yfinance data and tool results, per ticker + function (0 = off)
# CACHE_TTL_SECONDS=60

# agno usage telemetry (off unless set to true)
AGNO_TELEMETRY=false

# Ollama (only used when LLM_PROVIDER=ollama)
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_HOST=http://localhost:11434

# ── NLP models ────────────────────────────────────────────────────────────────
# spaCy model used for NER + lemmatisation (install: python -m spacy download <name>)
SPACY_MODEL=en_core_web_sm
# sentence-transformers model for RAG embeddings (all-mpnet-base-v2 = better, ~5x RAM)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Server ────────────────────────────────────────────────────────────────────
# PORT=8001
# Trust X-Forwarded-For from these proxy IPs (comma-separated, or * behind a PaaS
# load balancer) so rate limits use the real client IP.
# FORWARDED_ALLOW_IPS=127.0.0.1

# SQLite database file (sessions, messages, watchlists, alerts)
# DATABASE_PATH=data/financial_agent.db
# PostgreSQL instead of SQLite (e.g. Neon). Use Neon's *pooled* URL (-pooler host).
# When set, DATABASE_PATH is ignored. Pool size: DB_POOL_MIN_SIZE / DB_POOL_MAX_SIZE.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/financial_agent?sslmode=require

# Comma-separated allowed origins for CORS (default: http://localhost:5173)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8001

# ── Rate limits ───────────────────────────────────────────────────────────────
# Chat messages per minute per browser (X-Client-Id header; client IP if absent).
# Over the limit: HTTP 429 JSON {"detail": ...} + Retry-After. 0 disables.
# RATE_LIMIT_PER_MINUTE=20
# Also enforced on chat: requests per RATE_LIMIT_WINDOW seconds per session / per IP
# RATE_LIMIT_MAX=10
# IP_RATE_LIMIT_MAX=30
# RATE_LIMIT_WINDOW=60

# ── Sessions & logging ────────────────────────────────────────────────────────
# SESSION_TTL=1800
# MAX_SESSIONS=100
# OUTPUTS_DIR=outputs
# LOG_LEVEL=INFO

# ── Secrets ───────────────────────────────────────────────────────────────────
# GROQ_API_KEY, OPENROUTER_API_KEY (above) and API_KEY are secrets: keep them in .env (git-ignored)
# or your platform's secret store, never in the image or the frontend build.
#
# Optional: API key for endpoint authentication (leave unset to disable auth in dev)
# When set, all /api/ endpoints (except /api/health) require the X-API-Key header.
# Note: the bundled web UI does not send this header — use it for API-only deployments.
# API_KEY=your_secret_api_key_here
# Seconds before an OpenRouter call (primary or backup) is abandoned
OPENROUTER_TIMEOUT_SECONDS=30
