# ── LLM provider ──────────────────────────────────────────────────────────────
# "groq" (cloud, default) or "ollama" (local).
# With "ollama", the agent uses Ollama and falls back to Groq only if Ollama is
# unreachable AND GROQ_API_KEY is set.
LLM_PROVIDER=groq

# Groq (required when LLM_PROVIDER=groq). Without it the API still starts, but
# /api/health reports "degraded" and chat endpoints return 503.
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Ollama (only used when LLM_PROVIDER=ollama)
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_HOST=http://localhost:11434

# ── NLP models ────────────────────────────────────────────────────────────────
# spaCy model used for NER + lemmatisation (install: python -m spacy download <name>)
SPACY_MODEL=en_core_web_sm
# sentence-transformers model for RAG embeddings (all-mpnet-base-v2 = better, ~5x RAM)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Server ────────────────────────────────────────────────────────────────────
# PORT=8001
# Trust X-Forwarded-For from these proxy IPs (comma-separated, or * behind a PaaS
# load balancer) so rate limits use the real client IP.
# FORWARDED_ALLOW_IPS=127.0.0.1

# SQLite database file (sessions, messages, watchlists, alerts)
# DATABASE_PATH=data/financial_agent.db

# Comma-separated allowed origins for CORS (default: http://localhost:5173)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8001

# Optional: API key for endpoint authentication (leave unset to disable auth in dev)
# When set, all /api/ endpoints (except /api/health) require the X-API-Key header.
# Note: the bundled web UI does not send this header — use it for API-only deployments.
# API_KEY=your_secret_api_key_here
