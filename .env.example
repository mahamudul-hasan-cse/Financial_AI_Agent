# Required: Groq API key for LLM inference
GROQ_API_KEY=your_groq_api_key_here

# LLM provider: "groq" (cloud, default) or "ollama" (local)
# When set to "ollama", the agent tries Ollama first and falls back to Groq on failure.
LLM_PROVIDER=groq

# Ollama settings (only used when LLM_PROVIDER=ollama)
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434

# Optional: Comma-separated allowed origins for CORS (default: http://localhost:5173)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8001

# Optional: API key for endpoint authentication (leave unset to disable auth in dev)
# When set, all /api/ endpoints (except /api/health) require X-API-Key header
# API_KEY=your_secret_api_key_here
